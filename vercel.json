{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/showcase",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/showcase/:path*",
      "destination": "/",
      "permanent": true
    }
  ]
}